<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="EmptySlot.Mobile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:EmptySlot.Mobile.Pages"
    Shell.FlyoutBehavior="Disabled">

    <TabBar>
        <Tab Title="Search" Icon="search.png">
            <ShellContent ContentTemplate="{DataTemplate pages:SearchPage}" />
        </Tab>
        <Tab Title="Appointments" Icon="calendar.png">
            <ShellContent ContentTemplate="{DataTemplate pages:AppointmentsPage}" />
        </Tab>
    </TabBar>

</Shell>
