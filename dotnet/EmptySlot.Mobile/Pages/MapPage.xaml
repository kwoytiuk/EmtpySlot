<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:EmptySlot.Mobile.ViewModels"
             xmlns:models="clr-namespace:EmptySlot.Shared.Models;assembly=EmptySlot.Shared"
             x:Class="EmptySlot.Mobile.Pages.MapPage"
             x:DataType="vm:MapViewModel"
             Title="{Binding Title}"
             BackgroundColor="#F5F5F5">

    <Grid RowDefinitions="Auto,*">

        <!-- Header with search info - React website branding -->
        <VerticalStackLayout Grid.Row="0" Padding="16" Spacing="10">
            <VerticalStackLayout.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#7C3AED" Offset="0.0" />   <!-- violet-600 -->
                    <GradientStop Color="#2563EB" Offset="0.5" />   <!-- blue-600 -->
                    <GradientStop Color="#06B6D4" Offset="1.0" />   <!-- cyan-600 -->
                </LinearGradientBrush>
            </VerticalStackLayout.Background>

            <HorizontalStackLayout Spacing="8">
                <Label Text="🗺️"
                       FontSize="24"
                       VerticalOptions="Center" />
                <Label Text="{Binding Providers.Count, StringFormat='{0} locations'}"
                       FontSize="18"
                       FontAttributes="Bold"
                       TextColor="White"
                       VerticalOptions="Center" />
            </HorizontalStackLayout>

            <Label Text="⚡ Tap any pin to view provider details"
                   FontSize="12"
                   FontAttributes="Bold"
                   TextColor="White"
                   Opacity="0.95" />
        </VerticalStackLayout>

        <!-- Interactive Map -->
        <WebView x:Name="MapWebView"
                 Grid.Row="1"
                 IsVisible="{Binding HasProviders}"
                 BackgroundColor="White" />

        <!-- Empty State -->
        <VerticalStackLayout Grid.Row="1"
                           Padding="40"
                           Spacing="12"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           IsVisible="{Binding ShowEmptyState}">
            <Label Text="🗺️"
                   FontSize="48"
                   HorizontalOptions="Center" />
            <Label Text="No locations to display"
                   FontSize="18"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   TextColor="#666" />
            <Label Text="Search for providers to see them on the map"
                   FontSize="14"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center"
                   TextColor="#999" />
        </VerticalStackLayout>

        <!-- Loading Overlay -->
        <Grid Grid.Row="1"
              IsVisible="{Binding IsBusy}"
              BackgroundColor="#F0FFFFFF">
            <VerticalStackLayout Spacing="12" HorizontalOptions="Center" VerticalOptions="Center">
                <ActivityIndicator IsRunning="{Binding IsBusy}"
                                  Color="#A855F7"
                                  WidthRequest="48"
                                  HeightRequest="48" />
                <Label Text="Loading map..."
                       FontSize="16"
                       TextColor="#1F2937"
                       FontAttributes="Bold" />
            </VerticalStackLayout>
        </Grid>
    </Grid>

</ContentPage>
