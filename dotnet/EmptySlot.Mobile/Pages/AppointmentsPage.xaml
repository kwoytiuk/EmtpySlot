<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:EmptySlot.Mobile.ViewModels"
             xmlns:models="clr-namespace:EmptySlot.Shared.Models;assembly=EmptySlot.Shared"
             x:Class="EmptySlot.Mobile.Pages.AppointmentsPage"
             x:DataType="vm:AppointmentsViewModel"
             Title="{Binding Title}">

    <RefreshView Command="{Binding LoadAppointmentsCommand}"
                 IsRefreshing="{Binding IsBusy}">
        <CollectionView ItemsSource="{Binding Appointments}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Appointment">
                    <Frame Padding="15" Margin="10,5" CornerRadius="8">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="{Binding Provider.BusinessName}"
                                   FontSize="18"
                                   FontAttributes="Bold" />
                            <Label Text="{Binding Service.Name}"
                                   FontSize="16"
                                   TextColor="{StaticResource Gray600}" />
                            <HorizontalStackLayout Spacing="10">
                                <Label Text="{Binding AppointmentDate, StringFormat='{0:MMM dd, yyyy}'}"
                                       FontSize="14" />
                                <Label Text="{Binding StartTime, StringFormat='{0:hh\\:mm}'}"
                                       FontSize="14"
                                       FontAttributes="Bold" />
                            </HorizontalStackLayout>
                            <Label Text="{Binding Status}"
                                   FontSize="14"
                                   TextColor="{StaticResource Primary}" />
                            <Label Text="{Binding Price, StringFormat='${0:F2}'}"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource Gray900}" />
                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="20" VerticalOptions="Center">
                    <Label Text="No appointments yet"
                           FontSize="18"
                           HorizontalOptions="Center"
                           TextColor="{StaticResource Gray600}" />
                    <Label Text="Book your first appointment from the Search tab"
                           FontSize="14"
                           HorizontalOptions="Center"
                           TextColor="{StaticResource Gray600}"
                           Margin="0,10,0,0" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
        </CollectionView>
    </RefreshView>

</ContentPage>
