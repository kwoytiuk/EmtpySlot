<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:EmptySlot.Mobile.ViewModels"
             xmlns:models="clr-namespace:EmptySlot.Shared.Models;assembly=EmptySlot.Shared"
             x:Class="EmptySlot.Mobile.Pages.EmployeeDashboardPage"
             x:DataType="vm:EmployeeDashboardViewModel"
             Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <!-- Welcome Header -->
            <Frame Padding="20" CornerRadius="15" HasShadow="True" BackgroundColor="{StaticResource Primary}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="{Binding StaffName, StringFormat='Welcome, {0}!'}"
                           FontSize="26"
                           FontAttributes="Bold"
                           TextColor="White" />
                    <Label Text="{Binding BusinessName}"
                           FontSize="16"
                           TextColor="White"
                           Opacity="0.9" />
                </VerticalStackLayout>
            </Frame>

            <!-- Manage Schedule Card -->
            <Frame Padding="20" CornerRadius="12" HasShadow="True">
                <Frame.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ManageScheduleCommand}" />
                </Frame.GestureRecognizers>
                <HorizontalStackLayout Spacing="15">
                    <Label Text="📅"
                           FontSize="40"
                           VerticalOptions="Center" />
                    <VerticalStackLayout Spacing="5" VerticalOptions="Center" HorizontalOptions="StartAndExpand">
                        <Label Text="Manage My Schedule"
                               FontSize="18"
                               FontAttributes="Bold" />
                        <Label Text="Update your availability"
                               FontSize="14"
                               TextColor="{StaticResource Gray600}" />
                    </VerticalStackLayout>
                    <Label Text="›"
                           FontSize="30"
                           TextColor="{StaticResource Primary}"
                           VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Frame>

            <!-- Current Schedules -->
            <Label Text="Your Weekly Schedule"
                   FontSize="22"
                   FontAttributes="Bold"
                   Margin="0,10,0,0" />

            <CollectionView ItemsSource="{Binding Schedules}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:StaffSchedule">
                        <Frame Padding="15" Margin="0,5" CornerRadius="10" HasShadow="True">
                            <VerticalStackLayout Spacing="5">
                                <Label Text="{Binding DayOfWeek}"
                                       FontSize="16"
                                       FontAttributes="Bold" />
                                <Label FontSize="14" TextColor="{StaticResource Gray600}">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{Binding StartTime, StringFormat='{0:hh\\:mm tt}'}" />
                                            <Span Text=" - " />
                                            <Span Text="{Binding EndTime, StringFormat='{0:hh\\:mm tt}'}" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                            </VerticalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="40" Spacing="10">
                        <Label Text="No schedule set"
                               FontSize="16"
                               TextColor="{StaticResource Gray600}"
                               HorizontalTextAlignment="Center" />
                        <Label Text="Tap 'Manage My Schedule' to add your availability"
                               FontSize="14"
                               TextColor="{StaticResource Gray600}"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
            </CollectionView>

            <ActivityIndicator IsRunning="{Binding IsBusy}"
                              IsVisible="{Binding IsBusy}"
                              Color="{StaticResource Primary}"
                              Margin="0,20" />

            <!-- Logout Button -->
            <Button Text="Logout"
                    Command="{Binding LogoutCommand}"
                    BackgroundColor="{StaticResource Gray200}"
                    TextColor="{StaticResource Gray900}"
                    HeightRequest="50"
                    CornerRadius="10"
                    FontSize="16"
                    Margin="0,20,0,0" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
