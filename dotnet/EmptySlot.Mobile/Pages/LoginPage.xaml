<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:EmptySlot.Mobile.ViewModels"
             x:Class="EmptySlot.Mobile.Pages.LoginPage"
             x:DataType="vm:LoginViewModel"
             Title=""
             BackgroundColor="{StaticResource Gray50}">

    <ScrollView>
        <VerticalStackLayout Spacing="0">

            <!-- Header Section with Brand Gradient -->
            <Grid RowDefinitions="Auto" Padding="32,60,32,50">
                <Grid.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#DA3743" Offset="0.0" />
                        <GradientStop Color="#C62828" Offset="0.5" />
                        <GradientStop Color="#B71C1C" Offset="1.0" />
                    </LinearGradientBrush>
                </Grid.Background>

                <VerticalStackLayout Spacing="12">
                    <!-- Logo Icon with Calendar Design -->
                    <Border WidthRequest="90"
                            HeightRequest="90"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 22"
                            BackgroundColor="White"
                            HorizontalOptions="Center"
                            Shadow="{Shadow Brush=Black, Radius=24, Opacity=0.25, Offset='0,8'}">
                        <Grid>
                            <!-- Calendar Icon -->
                            <VerticalStackLayout Spacing="2" Padding="12">
                                <!-- Calendar header -->
                                <Border HeightRequest="16"
                                       BackgroundColor="#DA3743"
                                       StrokeThickness="0"
                                       StrokeShape="RoundRectangle 6"
                                       Margin="0,0,0,2">
                                    <HorizontalStackLayout Spacing="8" HorizontalOptions="Center" VerticalOptions="Center">
                                        <Ellipse WidthRequest="4" HeightRequest="4" Fill="White"/>
                                        <Ellipse WidthRequest="4" HeightRequest="4" Fill="White"/>
                                        <Ellipse WidthRequest="4" HeightRequest="4" Fill="White"/>
                                    </HorizontalStackLayout>
                                </Border>

                                <!-- Calendar body with time slot -->
                                <Grid RowDefinitions="*,*" ColumnDefinitions="*,*,*" RowSpacing="4" ColumnSpacing="4" Margin="4,6">
                                    <Ellipse Grid.Row="0" Grid.Column="0" WidthRequest="6" HeightRequest="6" Fill="#DA3743" Opacity="0.3"/>
                                    <Ellipse Grid.Row="0" Grid.Column="1" WidthRequest="6" HeightRequest="6" Fill="#DA3743" Opacity="0.3"/>
                                    <Ellipse Grid.Row="0" Grid.Column="2" WidthRequest="6" HeightRequest="6" Fill="#DA3743" Opacity="0.3"/>
                                    <Ellipse Grid.Row="1" Grid.Column="0" WidthRequest="6" HeightRequest="6" Fill="#DA3743" Opacity="0.3"/>
                                    <!-- Featured slot -->
                                    <Border Grid.Row="1" Grid.Column="1"
                                           WidthRequest="12" HeightRequest="12"
                                           BackgroundColor="#DA3743"
                                           StrokeThickness="0"
                                           StrokeShape="RoundRectangle 6"/>
                                    <Ellipse Grid.Row="1" Grid.Column="2" WidthRequest="6" HeightRequest="6" Fill="#DA3743" Opacity="0.3"/>
                                </Grid>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <!-- Brand Name -->
                    <Label HorizontalOptions="Center" Margin="0,8,0,0">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="Empty" FontSize="34" FontAttributes="Bold" TextColor="White"/>
                                <Span Text="Slot" FontSize="34" FontAttributes="Bold" TextColor="#FFE6E8"/>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>

                    <Label Text="Welcome Back"
                           FontSize="20"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"
                           TextColor="White"
                           Margin="0,4,0,0"
                           Opacity="0.95" />

                    <Label Text="Sign in to continue booking"
                           FontSize="15"
                           HorizontalOptions="Center"
                           TextColor="White"
                           Opacity="0.85" />
                </VerticalStackLayout>
            </Grid>

            <!-- Login Form Card -->
            <VerticalStackLayout Padding="24,0,24,40">
                <Border Margin="0,-40,0,0"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 24"
                        BackgroundColor="White"
                        Shadow="{Shadow Brush=Black, Radius=24, Opacity=0.1, Offset='0,8'}">
                    <VerticalStackLayout Padding="28,32" Spacing="24">

                        <!-- Email Input -->
                        <VerticalStackLayout Spacing="10">
                            <Label Text="Email"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource Gray700}" />
                            <Border StrokeThickness="2"
                                    Stroke="{StaticResource Gray300}"
                                    StrokeShape="RoundRectangle 12"
                                    BackgroundColor="White">
                                <Entry Placeholder="your@email.com"
                                       Text="{Binding Email}"
                                       Keyboard="Email"
                                       FontSize="16"
                                       TextColor="{StaticResource Gray900}"
                                       PlaceholderColor="{StaticResource Gray400}"
                                       Margin="16,4" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- Password Input -->
                        <VerticalStackLayout Spacing="10">
                            <Label Text="Password"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource Gray700}" />
                            <Border StrokeThickness="2"
                                    Stroke="{StaticResource Gray300}"
                                    StrokeShape="RoundRectangle 12"
                                    BackgroundColor="White">
                                <Entry Placeholder="Enter your password"
                                       Text="{Binding Password}"
                                       IsPassword="True"
                                       FontSize="16"
                                       TextColor="{StaticResource Gray900}"
                                       PlaceholderColor="{StaticResource Gray400}"
                                       Margin="16,4" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- Error Message -->
                        <Border IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 10"
                                BackgroundColor="#FEF2F2"
                                Padding="16,12">
                            <HorizontalStackLayout Spacing="10">
                                <Label Text="⚠️"
                                       FontSize="16"
                                       VerticalOptions="Center" />
                                <Label Text="{Binding ErrorMessage}"
                                       TextColor="{StaticResource Error}"
                                       FontSize="14"
                                       LineBreakMode="WordWrap"
                                       VerticalOptions="Center"
                                       HorizontalOptions="FillAndExpand" />
                            </HorizontalStackLayout>
                        </Border>

                        <!-- Login Button -->
                        <Button Text="Sign In"
                                Command="{Binding LoginCommand}"
                                TextColor="White"
                                HeightRequest="56"
                                CornerRadius="14"
                                FontSize="17"
                                FontAttributes="Bold"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                                Shadow="{Shadow Brush=#DA3743, Radius=16, Opacity=0.4, Offset='0,6'}">
                            <Button.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#DA3743" Offset="0.0" />
                                    <GradientStop Color="#C62828" Offset="1.0" />
                                </LinearGradientBrush>
                            </Button.Background>
                        </Button>

                        <!-- Loading Indicator -->
                        <ActivityIndicator IsRunning="{Binding IsBusy}"
                                          IsVisible="{Binding IsBusy}"
                                          Color="{StaticResource Primary}"
                                          WidthRequest="40"
                                          HeightRequest="40"
                                          HorizontalOptions="Center" />

                    </VerticalStackLayout>
                </Border>

                <!-- Sign Up Link -->
                <HorizontalStackLayout HorizontalOptions="Center"
                                      Spacing="6"
                                      Margin="0,32,0,0">
                    <Label Text="Don't have an account?"
                           TextColor="{StaticResource Gray600}"
                           FontSize="15" />
                    <Label Text="Sign Up"
                           TextColor="#DA3743"
                           FontSize="15"
                           FontAttributes="Bold"
                           TextDecorations="Underline">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding GoToRegisterCommand}" />
                        </Label.GestureRecognizers>
                    </Label>
                </HorizontalStackLayout>

                <!-- Branding Footer -->
                <Label HorizontalOptions="Center" Margin="0,40,0,0">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="Empty" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource Gray400}"/>
                            <Span Text="Slot" FontSize="16" FontAttributes="Bold" TextColor="#DA3743" />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>

            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
