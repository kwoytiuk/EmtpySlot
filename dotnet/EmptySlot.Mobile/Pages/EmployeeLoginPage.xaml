<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:EmptySlot.Mobile.ViewModels"
             x:Class="EmptySlot.Mobile.Pages.EmployeeLoginPage"
             x:DataType="vm:EmployeeLoginViewModel"
             Title="{Binding Title}"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="25" VerticalOptions="Center">

            <!-- Logo/Header -->
            <VerticalStackLayout Spacing="10" Margin="0,0,0,30">
                <Label Text="EmptySlot"
                       FontSize="36"
                       FontAttributes="Bold"
                       TextColor="{StaticResource Primary}"
                       HorizontalTextAlignment="Center" />
                <Label Text="Employee Portal"
                       FontSize="18"
                       TextColor="{StaticResource Gray600}"
                       HorizontalTextAlignment="Center" />
            </VerticalStackLayout>

            <!-- Login Form -->
            <Frame Padding="20" CornerRadius="15" HasShadow="True">
                <VerticalStackLayout Spacing="15">
                    <Label Text="Employee Sign In"
                           FontSize="24"
                           FontAttributes="Bold"
                           Margin="0,0,0,10" />

                    <!-- Email -->
                    <VerticalStackLayout Spacing="5">
                        <Label Text="Email" FontSize="14" TextColor="{StaticResource Gray600}" />
                        <Entry Text="{Binding Email}"
                               Placeholder="your@email.com"
                               Keyboard="Email"
                               BackgroundColor="{StaticResource Gray100}"
                               FontSize="16" />
                    </VerticalStackLayout>

                    <!-- Password -->
                    <VerticalStackLayout Spacing="5">
                        <Label Text="Password" FontSize="14" TextColor="{StaticResource Gray600}" />
                        <Entry Text="{Binding Password}"
                               Placeholder="Your password"
                               IsPassword="True"
                               BackgroundColor="{StaticResource Gray100}"
                               FontSize="16" />
                    </VerticalStackLayout>

                    <Label Text="Hint: Password is your first and last name without spaces, lowercase (e.g., 'sarahjohnson')"
                           FontSize="12"
                           TextColor="{StaticResource Gray600}"
                           LineBreakMode="WordWrap"
                           Margin="0,5,0,0" />

                    <!-- Login Button -->
                    <Button Text="Sign In"
                            Command="{Binding LoginCommand}"
                            BackgroundColor="{StaticResource Primary}"
                            TextColor="White"
                            HeightRequest="50"
                            CornerRadius="10"
                            FontSize="18"
                            FontAttributes="Bold"
                            Margin="0,10,0,0" />

                    <ActivityIndicator IsRunning="{Binding IsBusy}"
                                      IsVisible="{Binding IsBusy}"
                                      Color="{StaticResource Primary}"
                                      HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
