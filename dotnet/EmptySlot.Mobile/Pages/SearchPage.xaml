<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:EmptySlot.Mobile.ViewModels"
             xmlns:models="clr-namespace:EmptySlot.Shared.Models;assembly=EmptySlot.Shared"
             x:Class="EmptySlot.Mobile.Pages.SearchPage"
             x:DataType="vm:SearchViewModel"
             Title="Search"
             BackgroundColor="#F5F5F5">

    <Grid RowDefinitions="Auto,*">

        <!-- Search Header -->
        <VerticalStackLayout Grid.Row="0" Padding="12" Spacing="10" BackgroundColor="White">

            <!-- Search Filters Row -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <!-- Category Picker -->
                <Border Grid.Column="0"
                        StrokeThickness="1"
                        Stroke="#E0E0E0"
                        StrokeShape="RoundRectangle 6"
                        BackgroundColor="White">
                    <Picker ItemsSource="{Binding Categories}"
                            ItemDisplayBinding="{Binding Name}"
                            SelectedItem="{Binding SelectedCategory}"
                            Title="All restaurants"
                            FontSize="14"
                            TextColor="#333" />
                </Border>

                <!-- Location Entry with GPS -->
                <Border Grid.Column="1"
                        StrokeThickness="1"
                        Stroke="#E0E0E0"
                        StrokeShape="RoundRectangle 6"
                        BackgroundColor="White">
                    <Grid ColumnDefinitions="*,Auto">
                        <Entry Grid.Column="0"
                               Placeholder="Calgary, AB"
                               Text="{Binding SearchCity}"
                               FontSize="14"
                               TextColor="#333"
                               PlaceholderColor="#999"
                               HorizontalTextAlignment="Center" />
                        <Label Grid.Column="1"
                               Text="📍"
                               FontSize="18"
                               VerticalOptions="Center"
                               Padding="0,0,8,0">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding DetectLocationCommand}" />
                            </Label.GestureRecognizers>
                        </Label>
                        <ActivityIndicator Grid.Column="1"
                                          IsRunning="{Binding IsDetectingLocation}"
                                          IsVisible="{Binding IsDetectingLocation}"
                                          Color="#DA3743"
                                          WidthRequest="20"
                                          HeightRequest="20"
                                          Margin="0,0,8,0" />
                    </Grid>
                </Border>
            </Grid>

            <!-- Search Button -->
            <Button Text="Search"
                    Command="{Binding SearchCommand}"
                    BackgroundColor="#DA3743"
                    TextColor="White"
                    FontSize="16"
                    FontAttributes="Bold"
                    HeightRequest="44"
                    CornerRadius="6"
                    Margin="0,4,0,0" />

            <!-- Filter Options Bar -->
            <ScrollView Orientation="Horizontal" HeightRequest="40">
                <HorizontalStackLayout Spacing="8">
                    <!-- Map Button -->
                    <Border StrokeThickness="1"
                            Stroke="#DA3743"
                            StrokeShape="RoundRectangle 20"
                            BackgroundColor="White"
                            Padding="12,6">
                        <Label Text="🗺️ Map"
                               FontSize="13"
                               TextColor="#DA3743"
                               FontAttributes="Bold">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ShowMapCommand}" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Border>

                    <!-- Filters Button -->
                    <Border StrokeThickness="1"
                            Stroke="#CCC"
                            StrokeShape="RoundRectangle 20"
                            BackgroundColor="White"
                            Padding="12,6">
                        <Label Text="⚙️ Filters"
                               FontSize="13"
                               TextColor="#666"
                               FontAttributes="Bold">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ShowFiltersCommand}" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Border>

                    <!-- Distance -->
                    <Border StrokeThickness="1"
                            Stroke="#CCC"
                            StrokeShape="RoundRectangle 20"
                            BackgroundColor="White"
                            Padding="2,0">
                        <Picker ItemsSource="{Binding RadiusOptions}"
                                SelectedItem="{Binding SelectedRadius}"
                                FontSize="13"
                                TextColor="#666"
                                WidthRequest="90" />
                    </Border>
                </HorizontalStackLayout>
            </ScrollView>

        </VerticalStackLayout>

        <!-- Provider List -->
        <RefreshView Grid.Row="1"
                    Command="{Binding SearchCommand}"
                    IsRefreshing="{Binding IsBusy}"
                    RefreshColor="#DA3743">
            <CollectionView ItemsSource="{Binding Providers}"
                           SelectionMode="None"
                           BackgroundColor="#F5F5F5">

                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="40" Spacing="12" HorizontalOptions="Center" VerticalOptions="Center">
                        <Label Text="🔍"
                               FontSize="48"
                               HorizontalOptions="Center" />
                        <Label Text="No providers found"
                               FontSize="18"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               TextColor="#666" />
                        <Label Text="Tap Search to find providers"
                               FontSize="14"
                               HorizontalOptions="Center"
                               TextColor="#999" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Provider">
                        <!-- OpenTable-Style Horizontal Card -->
                        <Border Margin="0,0,0,8"
                                StrokeThickness="0"
                                BackgroundColor="White"
                                Padding="12">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:SearchViewModel}}, Path=SelectProviderCommand}"
                                                     CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>

                            <Grid ColumnDefinitions="90,*" ColumnSpacing="12" RowSpacing="0">

                                <!-- Restaurant Image -->
                                <Border Grid.Column="0"
                                        Grid.RowSpan="2"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 4"
                                        HeightRequest="90"
                                        WidthRequest="90"
                                        VerticalOptions="Start">
                                    <Grid>
                                        <!-- Colored Background -->
                                        <BoxView CornerRadius="4">
                                            <BoxView.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#E63946" Offset="0.0" />
                                                    <GradientStop Color="#D62828" Offset="1.0" />
                                                </LinearGradientBrush>
                                            </BoxView.Background>
                                        </BoxView>

                                        <!-- Business Initial -->
                                        <Label Text="{Binding BusinessName, StringFormat='{0:C}'}"
                                               FontSize="28"
                                               FontAttributes="Bold"
                                               TextColor="White"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center" />
                                    </Grid>
                                </Border>

                                <!-- Restaurant Info -->
                                <VerticalStackLayout Grid.Column="1" Spacing="3">

                                    <!-- Name -->
                                    <Label Text="{Binding BusinessName}"
                                           FontSize="15"
                                           FontAttributes="Bold"
                                           TextColor="#1A1A1A"
                                           LineBreakMode="TailTruncation" />

                                    <!-- Stars & Reviews & Price -->
                                    <HorizontalStackLayout Spacing="4">
                                        <Label Text="★★★★☆"
                                               FontSize="11"
                                               TextColor="#FF6B35"
                                               VerticalOptions="Center" />
                                        <Label Text="{Binding RatingAverage, StringFormat='{0:F1}'}"
                                               FontSize="11"
                                               FontAttributes="Bold"
                                               TextColor="#2A2A2A"
                                               VerticalOptions="Center" />
                                        <Label Text="{Binding RatingCount, StringFormat='({0})'}"
                                               FontSize="11"
                                               TextColor="#757575"
                                               VerticalOptions="Center" />
                                        <Label Text="·"
                                               FontSize="11"
                                               TextColor="#CCC"
                                               VerticalOptions="Center" />
                                        <Label Text="$$"
                                               FontSize="11"
                                               FontAttributes="Bold"
                                               TextColor="#2A2A2A"
                                               VerticalOptions="Center" />
                                    </HorizontalStackLayout>

                                    <!-- Cuisine/Description -->
                                    <Label Text="{Binding Description}"
                                           FontSize="12"
                                           TextColor="#757575"
                                           LineBreakMode="TailTruncation"
                                           MaxLines="1" />

                                    <!-- Location -->
                                    <HorizontalStackLayout Spacing="3" IsVisible="{Binding Locations.Count}">
                                        <Label Text="📍"
                                               FontSize="11" />
                                        <Label FontSize="11"
                                               TextColor="#757575">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{Binding Locations[0].City}" />
                                                    <Span Text=" · 0.8 mi" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                    </HorizontalStackLayout>

                                    <!-- Time Slots -->
                                    <ScrollView Orientation="Horizontal" Margin="0,6,0,0">
                                        <HorizontalStackLayout Spacing="6">
                                            <Border StrokeThickness="1"
                                                    Stroke="#DA3743"
                                                    StrokeShape="RoundRectangle 3"
                                                    BackgroundColor="White"
                                                    Padding="12,5">
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:SearchViewModel}}, Path=QuickBookCommand}"
                                                                         CommandParameter="{Binding .}" />
                                                </Border.GestureRecognizers>
                                                <Label Text="5:45 PM"
                                                       FontSize="10"
                                                       FontAttributes="Bold"
                                                       TextColor="#DA3743" />
                                            </Border>

                                            <Border StrokeThickness="1"
                                                    Stroke="#DA3743"
                                                    StrokeShape="RoundRectangle 3"
                                                    BackgroundColor="White"
                                                    Padding="12,5">
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:SearchViewModel}}, Path=QuickBookCommand}"
                                                                         CommandParameter="{Binding .}" />
                                                </Border.GestureRecognizers>
                                                <Label Text="7:00 PM"
                                                       FontSize="10"
                                                       FontAttributes="Bold"
                                                       TextColor="#DA3743" />
                                            </Border>

                                            <Border StrokeThickness="1"
                                                    Stroke="#DA3743"
                                                    StrokeShape="RoundRectangle 3"
                                                    BackgroundColor="White"
                                                    Padding="12,5">
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:SearchViewModel}}, Path=QuickBookCommand}"
                                                                         CommandParameter="{Binding .}" />
                                                </Border.GestureRecognizers>
                                                <Label Text="7:15 PM"
                                                       FontSize="10"
                                                       FontAttributes="Bold"
                                                       TextColor="#DA3743" />
                                            </Border>
                                        </HorizontalStackLayout>
                                    </ScrollView>

                                    <!-- Booked Indicator -->
                                    <HorizontalStackLayout Spacing="3" Margin="0,4,0,0">
                                        <Label Text="🔥"
                                               FontSize="10" />
                                        <Label Text="Booked 47 times today"
                                               FontSize="10"
                                               TextColor="#DA3743"
                                               FontAttributes="Bold" />
                                    </HorizontalStackLayout>

                                </VerticalStackLayout>

                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <!-- Loading Overlay -->
        <Grid Grid.Row="1"
              IsVisible="{Binding IsBusy}"
              BackgroundColor="#80FFFFFF">
            <VerticalStackLayout Spacing="12" HorizontalOptions="Center" VerticalOptions="Center">
                <ActivityIndicator IsRunning="{Binding IsBusy}"
                                  Color="#DA3743"
                                  WidthRequest="40"
                                  HeightRequest="40" />
                <Label Text="Searching..."
                       FontSize="14"
                       TextColor="#666"
                       FontAttributes="Bold" />
            </VerticalStackLayout>
        </Grid>

    </Grid>

</ContentPage>
