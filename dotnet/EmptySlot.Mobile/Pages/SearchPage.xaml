<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:EmptySlot.Mobile.ViewModels"
             xmlns:models="clr-namespace:EmptySlot.Shared.Models;assembly=EmptySlot.Shared"
             x:Class="EmptySlot.Mobile.Pages.SearchPage"
             x:DataType="vm:SearchViewModel"
             Title="Marketplace"
             BackgroundColor="White">

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- Clean Search Bar -->
        <Border Grid.Row="0"
                Margin="12,12,12,8"
                StrokeThickness="1"
                Stroke="#E5E7EB"
                StrokeShape="RoundRectangle 24"
                BackgroundColor="#F9FAFB"
                Padding="16,0">
            <Grid ColumnDefinitions="*,Auto">
                <Entry Grid.Column="0"
                       Placeholder="What are you looking for?"
                       Text="{Binding SearchQuery}"
                       FontSize="15"
                       TextColor="#1F2937"
                       PlaceholderColor="#9CA3AF"
                       VerticalOptions="Center"
                       BackgroundColor="Transparent" />
                <Label Grid.Column="1"
                       Text="🔍"
                       FontSize="20"
                       VerticalOptions="Center"
                       Margin="8,0">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SearchCommand}" />
                    </Label.GestureRecognizers>
                </Label>
            </Grid>
        </Border>

        <!-- Filter Chips -->
        <ScrollView Grid.Row="1" Orientation="Horizontal" Margin="12,0,12,12">
            <HorizontalStackLayout Spacing="8">

                <!-- Bookmark/Save Button -->
                <Border StrokeThickness="1"
                        Stroke="#E5E7EB"
                        StrokeShape="RoundRectangle 20"
                        Padding="12,8"
                        BackgroundColor="White">
                    <Label Text="🔖" FontSize="16" />
                </Border>

                <!-- Location Dropdown -->
                <Border StrokeThickness="1"
                        Stroke="#E5E7EB"
                        StrokeShape="RoundRectangle 20"
                        Padding="12,8"
                        BackgroundColor="White">
                    <HorizontalStackLayout Spacing="4">
                        <Label Text="{Binding SearchCity, TargetNullValue='Calgary'}"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="#1F2937"
                               VerticalOptions="Center" />
                        <Label Text="▼"
                               FontSize="10"
                               TextColor="#6B7280"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ShowLocationFilterCommand}" />
                    </Border.GestureRecognizers>
                </Border>

                <!-- Distance Dropdown -->
                <Border StrokeThickness="1"
                        Stroke="#E5E7EB"
                        StrokeShape="RoundRectangle 20"
                        Padding="12,8"
                        BackgroundColor="White">
                    <HorizontalStackLayout Spacing="4">
                        <Label Text="{Binding SelectedRadius, StringFormat='{0} km', TargetNullValue='50 km'}"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="#1F2937"
                               VerticalOptions="Center" />
                        <Label Text="▼"
                               FontSize="10"
                               TextColor="#6B7280"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ShowDistanceFilterCommand}" />
                    </Border.GestureRecognizers>
                </Border>

                <!-- Filters Button -->
                <Border StrokeThickness="1"
                        Stroke="#E5E7EB"
                        StrokeShape="RoundRectangle 20"
                        Padding="12,8"
                        BackgroundColor="White">
                    <HorizontalStackLayout Spacing="6">
                        <Label Text="⚙️" FontSize="14" VerticalOptions="Center" />
                        <Label Text="Filters"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="#1F2937"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ShowFiltersCommand}" />
                    </Border.GestureRecognizers>
                </Border>

                <!-- Sort Button -->
                <Border StrokeThickness="1"
                        Stroke="#E5E7EB"
                        StrokeShape="RoundRectangle 20"
                        Padding="12,8"
                        BackgroundColor="White">
                    <HorizontalStackLayout Spacing="6">
                        <Label Text="↕️" FontSize="14" VerticalOptions="Center" />
                        <Label Text="Sort"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="#1F2937"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ShowSortCommand}" />
                    </Border.GestureRecognizers>
                </Border>

                <!-- Map View Button -->
                <Border StrokeThickness="1"
                        Stroke="#E5E7EB"
                        StrokeShape="RoundRectangle 20"
                        Padding="12,8"
                        BackgroundColor="White">
                    <HorizontalStackLayout Spacing="6">
                        <Label Text="🗺️" FontSize="14" VerticalOptions="Center" />
                        <Label Text="Map"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="#1F2937"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ShowMapCommand}" />
                    </Border.GestureRecognizers>
                </Border>

            </HorizontalStackLayout>
        </ScrollView>

        <!-- Provider Grid (2 columns like Facebook Marketplace) -->
        <RefreshView Grid.Row="2"
                    Command="{Binding SearchCommand}"
                    IsRefreshing="{Binding IsBusy}">
            <CollectionView ItemsSource="{Binding Providers}"
                           SelectionMode="None"
                           BackgroundColor="#F9FAFB">

                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" Span="2" />
                </CollectionView.ItemsLayout>

                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="40" Spacing="12"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center">
                        <Label Text="🔍"
                               FontSize="56"
                               HorizontalOptions="Center" />
                        <Label Text="No providers found"
                               FontSize="18"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               TextColor="#1F2937" />
                        <Label Text="Try adjusting your filters"
                               FontSize="14"
                               HorizontalOptions="Center"
                               TextColor="#6B7280" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Provider">
                        <Border Margin="6"
                                StrokeThickness="1"
                                Stroke="#E5E7EB"
                                BackgroundColor="White"
                                StrokeShape="RoundRectangle 12">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:SearchViewModel}}, Path=SelectProviderCommand}"
                                                     CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>

                            <Grid RowDefinitions="160,Auto">

                                <!-- Provider Image with Slot Count Overlay -->
                                <Border Grid.Row="0"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 12,12,0,0">
                                    <Grid>
                                        <!-- Gradient Background (placeholder for image) -->
                                        <BoxView>
                                            <BoxView.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#3B82F6" Offset="0.0" />
                                                    <GradientStop Color="#A855F7" Offset="0.5" />
                                                    <GradientStop Color="#EC4899" Offset="1.0" />
                                                </LinearGradientBrush>
                                            </BoxView.Background>
                                        </BoxView>

                                        <!-- Business Initial -->
                                        <Label Text="{Binding BusinessName, StringFormat='{0:C}'}"
                                               FontSize="40"
                                               FontAttributes="Bold"
                                               TextColor="White"
                                               Opacity="0.3"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center" />

                                        <!-- Slot Count Overlay (Your unique feature!) -->
                                        <Border HorizontalOptions="Start"
                                               VerticalOptions="End"
                                               Margin="8"
                                               BackgroundColor="#10B981E6"
                                               StrokeThickness="0"
                                               StrokeShape="RoundRectangle 8"
                                               Padding="8,4">
                                            <Label Text="5 slots today"
                                                   FontSize="11"
                                                   FontAttributes="Bold"
                                                   TextColor="White" />
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- Provider Info -->
                                <VerticalStackLayout Grid.Row="1" Padding="8" Spacing="4">

                                    <!-- Price/Rating -->
                                    <Label FontSize="16" FontAttributes="Bold" TextColor="#1F2937">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="⭐ " />
                                                <Span Text="{Binding RatingAverage, StringFormat='{0:F1}'}" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>

                                    <!-- Provider Name -->
                                    <Label Text="{Binding BusinessName}"
                                           FontSize="14"
                                           TextColor="#1F2937"
                                           LineBreakMode="TailTruncation"
                                           MaxLines="1" />

                                    <!-- Location -->
                                    <Label FontSize="12"
                                           TextColor="#6B7280"
                                           LineBreakMode="TailTruncation"
                                           IsVisible="{Binding Locations.Count}">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{Binding Locations[0].City}" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>

                                </VerticalStackLayout>

                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

    </Grid>

</ContentPage>
