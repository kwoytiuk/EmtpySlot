<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:EmptySlot.Mobile.ViewModels"
             xmlns:models="clr-namespace:EmptySlot.Shared.Models;assembly=EmptySlot.Shared"
             x:Class="EmptySlot.Mobile.Pages.SearchPage"
             x:DataType="vm:SearchViewModel"
             Title=""
             BackgroundColor="White">

    <Grid RowDefinitions="Auto,*">

        <!-- Search Header - Compact -->
        <VerticalStackLayout Grid.Row="0" Padding="16,12" Spacing="12" BackgroundColor="{StaticResource Gray50}">

            <!-- Category & Location Filters -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <Border Grid.Column="0"
                        StrokeThickness="1"
                        Stroke="{StaticResource Gray300}"
                        StrokeShape="RoundRectangle 8"
                        BackgroundColor="White"
                        Padding="2">
                    <Picker ItemsSource="{Binding Categories}"
                            ItemDisplayBinding="{Binding Name}"
                            SelectedItem="{Binding SelectedCategory}"
                            Title="All categories"
                            FontSize="14"
                            TextColor="{StaticResource Gray800}" />
                </Border>

                <Border Grid.Column="1"
                        StrokeThickness="1"
                        Stroke="{StaticResource Gray300}"
                        StrokeShape="RoundRectangle 8"
                        BackgroundColor="White"
                        Padding="2">
                    <Entry Placeholder="Calgary, AB"
                           Text="{Binding SearchCity}"
                           FontSize="14"
                           TextColor="{StaticResource Gray800}"
                           HorizontalTextAlignment="Center"
                           VerticalOptions="Center" />
                </Border>
            </Grid>

            <!-- Quick Action Buttons -->
            <HorizontalStackLayout Spacing="8">
                <Border StrokeThickness="1"
                        Stroke="{StaticResource Primary}"
                        StrokeShape="RoundRectangle 20"
                        BackgroundColor="White"
                        Padding="12,6">
                    <Label Text="🗺️ Map View"
                           FontSize="13"
                           TextColor="{StaticResource Primary}"
                           FontAttributes="Bold" />
                </Border>

                <Border StrokeThickness="1"
                        Stroke="{StaticResource Gray300}"
                        StrokeShape="RoundRectangle 20"
                        BackgroundColor="White"
                        Padding="12,6">
                    <HorizontalStackLayout Spacing="4">
                        <Label Text="⚙️"
                               FontSize="13"
                               VerticalOptions="Center" />
                        <Label Text="Filters"
                               FontSize="13"
                               TextColor="{StaticResource Gray700}"
                               FontAttributes="Bold"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Border>

                <Border StrokeThickness="1"
                        Stroke="{StaticResource Gray300}"
                        StrokeShape="RoundRectangle 20"
                        BackgroundColor="White"
                        Padding="12,6">
                    <Picker ItemsSource="{Binding RadiusOptions}"
                            SelectedItem="{Binding SelectedRadius}"
                            FontSize="13"
                            TextColor="{StaticResource Gray700}"
                            WidthRequest="80" />
                </Border>
            </HorizontalStackLayout>

        </VerticalStackLayout>

        <!-- Provider List - Horizontal Layout -->
        <RefreshView Grid.Row="1"
                    Command="{Binding SearchCommand}"
                    IsRefreshing="{Binding IsBusy}"
                    RefreshColor="{StaticResource Primary}">
            <CollectionView ItemsSource="{Binding Providers}"
                           SelectionMode="None"
                           BackgroundColor="White">

                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="40" Spacing="12" HorizontalOptions="Center" VerticalOptions="Center">
                        <Label Text="🔍"
                               FontSize="48"
                               HorizontalOptions="Center"
                               Opacity="0.5" />
                        <Label Text="No providers found"
                               FontSize="18"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               TextColor="{StaticResource Gray700}" />
                        <Label Text="Try adjusting your filters"
                               FontSize="14"
                               HorizontalOptions="Center"
                               TextColor="{StaticResource Gray500}" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Provider">
                        <!-- Horizontal Card Layout (OpenTable Style) -->
                        <Border Margin="0,0,0,1"
                                StrokeThickness="0"
                                BackgroundColor="White"
                                Padding="16,12">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:SearchViewModel}}, Path=SelectProviderCommand}"
                                                     CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>

                            <Grid ColumnDefinitions="100,*" ColumnSpacing="12">

                                <!-- Provider Image/Thumbnail -->
                                <Border Grid.Column="0"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 8"
                                        HeightRequest="100"
                                        WidthRequest="100"
                                        VerticalOptions="Start">
                                    <Grid>
                                        <!-- Gradient Background -->
                                        <BoxView CornerRadius="8">
                                            <BoxView.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#3B82F6" Offset="0.0" />
                                                    <GradientStop Color="#1D4ED8" Offset="1.0" />
                                                </LinearGradientBrush>
                                            </BoxView.Background>
                                        </BoxView>

                                        <!-- Business Initial -->
                                        <Label Text="{Binding BusinessName, StringFormat='{0:C}'}"
                                               FontSize="32"
                                               FontAttributes="Bold"
                                               TextColor="White"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center"
                                               Opacity="0.7" />

                                        <!-- Verified Badge (if applicable) -->
                                        <Border IsVisible="{Binding IsVerified}"
                                                WidthRequest="20"
                                                HeightRequest="20"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 10"
                                                BackgroundColor="{StaticResource Success}"
                                                Margin="4"
                                                VerticalOptions="Start"
                                                HorizontalOptions="End">
                                            <Label Text="✓"
                                                   FontSize="12"
                                                   FontAttributes="Bold"
                                                   TextColor="White"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center" />
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- Provider Info -->
                                <VerticalStackLayout Grid.Column="1" Spacing="4">

                                    <!-- Name -->
                                    <Label Text="{Binding BusinessName}"
                                           FontSize="16"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource Gray900}"
                                           LineBreakMode="TailTruncation"
                                           MaxLines="1" />

                                    <!-- Rating, Reviews, Price -->
                                    <HorizontalStackLayout Spacing="6">
                                        <Label Text="★★★★☆"
                                               FontSize="12"
                                               TextColor="{StaticResource Warning}"
                                               VerticalOptions="Center" />
                                        <Label Text="{Binding RatingAverage, StringFormat='{0:F1}'}"
                                               FontSize="12"
                                               FontAttributes="Bold"
                                               TextColor="{StaticResource Gray800}"
                                               VerticalOptions="Center" />
                                        <Label Text="{Binding RatingCount, StringFormat='({0})'}"
                                               FontSize="12"
                                               TextColor="{StaticResource Gray500}"
                                               VerticalOptions="Center" />
                                        <Label Text="•"
                                               FontSize="12"
                                               TextColor="{StaticResource Gray400}"
                                               VerticalOptions="Center" />
                                        <Label Text="$$"
                                               FontSize="12"
                                               TextColor="{StaticResource Gray600}"
                                               VerticalOptions="Center" />
                                    </HorizontalStackLayout>

                                    <!-- Description/Cuisine -->
                                    <Label Text="{Binding Description}"
                                           FontSize="13"
                                           TextColor="{StaticResource Gray600}"
                                           LineBreakMode="TailTruncation"
                                           MaxLines="1"
                                           Margin="0,2,0,0" />

                                    <!-- Location & Distance -->
                                    <HorizontalStackLayout Spacing="4" IsVisible="{Binding Locations.Count}">
                                        <Label Text="📍"
                                               FontSize="12" />
                                        <Label FontSize="12"
                                               TextColor="{StaticResource Gray600}">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{Binding Locations[0].City}" />
                                                    <Span Text=" • " />
                                                    <Span Text="2.8 mi" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                    </HorizontalStackLayout>

                                    <!-- Available Time Slots (OpenTable Style) -->
                                    <ScrollView Orientation="Horizontal" Margin="0,6,0,0">
                                        <HorizontalStackLayout Spacing="6">
                                            <Border StrokeThickness="1"
                                                    Stroke="{StaticResource Primary}"
                                                    StrokeShape="RoundRectangle 4"
                                                    BackgroundColor="White"
                                                    Padding="10,6">
                                                <Label Text="5:30 PM"
                                                       FontSize="11"
                                                       FontAttributes="Bold"
                                                       TextColor="{StaticResource Primary}" />
                                            </Border>

                                            <Border StrokeThickness="1"
                                                    Stroke="{StaticResource Primary}"
                                                    StrokeShape="RoundRectangle 4"
                                                    BackgroundColor="White"
                                                    Padding="10,6">
                                                <Label Text="6:00 PM"
                                                       FontSize="11"
                                                       FontAttributes="Bold"
                                                       TextColor="{StaticResource Primary}" />
                                            </Border>

                                            <Border StrokeThickness="1"
                                                    Stroke="{StaticResource Primary}"
                                                    StrokeShape="RoundRectangle 4"
                                                    BackgroundColor="White"
                                                    Padding="10,6">
                                                <Label Text="6:30 PM"
                                                       FontSize="11"
                                                       FontAttributes="Bold"
                                                       TextColor="{StaticResource Primary}" />
                                            </Border>

                                            <Border StrokeThickness="1"
                                                    Stroke="{StaticResource Primary}"
                                                    StrokeShape="RoundRectangle 4"
                                                    BackgroundColor="White"
                                                    Padding="10,6">
                                                <Label Text="7:00 PM"
                                                       FontSize="11"
                                                       FontAttributes="Bold"
                                                       TextColor="{StaticResource Primary}" />
                                            </Border>
                                        </HorizontalStackLayout>
                                    </ScrollView>

                                    <!-- Booked Times Indicator -->
                                    <HorizontalStackLayout Spacing="4" Margin="0,4,0,0">
                                        <Label Text="🔥"
                                               FontSize="11"
                                               VerticalOptions="Center" />
                                        <Label Text="Booked 47 times today"
                                               FontSize="11"
                                               TextColor="{StaticResource Error}"
                                               FontAttributes="Bold"
                                               VerticalOptions="Center" />
                                    </HorizontalStackLayout>

                                </VerticalStackLayout>
                            </Grid>

                            <!-- Separator Line -->
                            <BoxView HeightRequest="1"
                                     BackgroundColor="{StaticResource Gray200}"
                                     VerticalOptions="End"
                                     Margin="-16,0" />
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <!-- Loading Indicator -->
        <Grid Grid.Row="1"
              IsVisible="{Binding IsBusy}"
              BackgroundColor="#E0FFFFFF">
            <ActivityIndicator IsRunning="{Binding IsBusy}"
                              Color="{StaticResource Primary}"
                              WidthRequest="40"
                              HeightRequest="40"
                              HorizontalOptions="Center"
                              VerticalOptions="Center" />
        </Grid>

    </Grid>

</ContentPage>
