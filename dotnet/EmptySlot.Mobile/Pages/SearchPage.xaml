<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:EmptySlot.Mobile.ViewModels"
             xmlns:models="clr-namespace:EmptySlot.Shared.Models;assembly=EmptySlot.Shared"
             xmlns:helpers="clr-namespace:EmptySlot.Mobile.Helpers"
             x:Class="EmptySlot.Mobile.Pages.SearchPage"
             x:DataType="vm:SearchViewModel"
             Title="Find Services"
             BackgroundColor="White">

    <Grid RowDefinitions="Auto,*">

        <!-- Hero Header with React Website Design -->
        <VerticalStackLayout Grid.Row="0" Padding="20,16" Spacing="16">
            <VerticalStackLayout.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#7C3AED" Offset="0.0" />   <!-- violet-600 -->
                    <GradientStop Color="#2563EB" Offset="0.5" />   <!-- blue-600 -->
                    <GradientStop Color="#06B6D4" Offset="1.0" />   <!-- cyan-600 -->
                </LinearGradientBrush>
            </VerticalStackLayout.Background>

            <!-- Tagline Badge -->
            <Border BackgroundColor="#FFFFFF33"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 20"
                    Padding="12,6"
                    HorizontalOptions="Center">
                <Label Text="⚡ Stop wasting time in waiting rooms"
                       TextColor="White"
                       FontSize="11"
                       FontAttributes="Bold" />
            </Border>

            <!-- Main Hero Text -->
            <Label HorizontalOptions="Center" HorizontalTextAlignment="Center">
                <Label.FormattedText>
                    <FormattedString>
                        <Span Text="Life's Too Short For" FontSize="24" FontAttributes="Bold" TextColor="White"/>
                        <Span Text="&#x0a;"/>
                        <Span Text="Empty Slots" FontSize="28" FontAttributes="Bold" TextColor="#FDE047"/>
                    </FormattedString>
                </Label.FormattedText>
            </Label>

            <!-- Subheading -->
            <Label Text="Book it. Now."
                   TextColor="White"
                   FontSize="16"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   Margin="0,-8,0,0" />

            <!-- Search Card -->
            <Border BackgroundColor="#FFFFFFF2"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 20"
                    Padding="12"
                    Shadow="{Shadow Brush=Black, Radius=20, Opacity=0.3, Offset='0,8'}">
                <VerticalStackLayout Spacing="10">
                    <!-- Category Picker -->
                    <Border StrokeThickness="0"
                            StrokeShape="RoundRectangle 12"
                            BackgroundColor="White">
                        <Picker ItemsSource="{Binding Categories}"
                                ItemDisplayBinding="{Binding Name}"
                                SelectedItem="{Binding SelectedCategory}"
                                Title="What do you need? (All Services)"
                                FontSize="15"
                                FontAttributes="Bold"
                                TextColor="#1F2937" />
                    </Border>

                    <!-- Location Entry -->
                    <Border StrokeThickness="0"
                            StrokeShape="RoundRectangle 12"
                            BackgroundColor="White">
                        <Grid ColumnDefinitions="*,Auto">
                            <Entry Grid.Column="0"
                                   Placeholder="📍 Calgary, AB"
                                   Text="{Binding SearchCity}"
                                   FontSize="15"
                                   FontAttributes="Bold"
                                   TextColor="#1F2937"
                                   PlaceholderColor="#9CA3AF"
                                   HorizontalTextAlignment="Start"
                                   Margin="12,0" />
                            <ActivityIndicator Grid.Column="1"
                                              IsRunning="{Binding IsDetectingLocation}"
                                              IsVisible="{Binding IsDetectingLocation}"
                                              Color="#A855F7"
                                              WidthRequest="24"
                                              HeightRequest="24"
                                              Margin="0,0,12,0" />
                        </Grid>
                    </Border>

                    <!-- Search Button -->
                    <Button Text="Find Slots →"
                            Command="{Binding SearchCommand}"
                            TextColor="White"
                            FontSize="16"
                            FontAttributes="Bold"
                            HeightRequest="52"
                            CornerRadius="12"
                            Shadow="{Shadow Brush=#A855F7, Radius=12, Opacity=0.4, Offset='0,4'}">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#EC4899" Offset="0.0" />   <!-- pink-500 -->
                                <GradientStop Color="#A855F7" Offset="1.0" />   <!-- purple-600 -->
                            </LinearGradientBrush>
                        </Button.Background>
                    </Button>
                </VerticalStackLayout>
            </Border>

            <!-- Quick Filters -->
            <ScrollView Orientation="Horizontal" HeightRequest="40">
                <HorizontalStackLayout Spacing="8">
                    <!-- Map Button -->
                    <Border StrokeThickness="2"
                            Stroke="White"
                            StrokeShape="RoundRectangle 20"
                            Padding="14,6"
                            BackgroundColor="#FFFFFF33">
                        <Label Text="🗺️ Map View"
                               FontSize="13"
                               TextColor="White"
                               FontAttributes="Bold"
                               VerticalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ShowMapCommand}" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Border>

                    <!-- Radius Picker -->
                    <Border StrokeThickness="2"
                            Stroke="White"
                            StrokeShape="RoundRectangle 20"
                            Padding="6,0"
                            BackgroundColor="#FFFFFF33">
                        <Picker ItemsSource="{Binding RadiusOptions}"
                                SelectedItem="{Binding SelectedRadius}"
                                FontSize="13"
                                FontAttributes="Bold"
                                TextColor="White"
                                TitleColor="White"
                                WidthRequest="90" />
                    </Border>
                </HorizontalStackLayout>
            </ScrollView>
        </VerticalStackLayout>

        <!-- Provider List -->
        <RefreshView Grid.Row="1"
                    Command="{Binding SearchCommand}"
                    IsRefreshing="{Binding IsBusy}"
                    RefreshColor="#A855F7">
            <CollectionView ItemsSource="{Binding Providers}"
                           SelectionMode="None"
                           BackgroundColor="#F9FAFB">

                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="40" Spacing="12"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       IsVisible="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}">
                        <Label Text="⚡"
                               FontSize="56"
                               HorizontalOptions="Center" />
                        <Label Text="Ready to find your slot?"
                               FontSize="20"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               TextColor="#1F2937" />
                        <Label Text="Tap 'Find Slots' to see available services"
                               FontSize="14"
                               HorizontalOptions="Center"
                               TextColor="#6B7280"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Provider">
                        <!-- Provider Card -->
                        <Border Margin="12,6"
                                StrokeThickness="2"
                                Stroke="#E5E7EB"
                                BackgroundColor="White"
                                Padding="0"
                                StrokeShape="RoundRectangle 20"
                                Shadow="{Shadow Brush=Black, Radius=16, Opacity=0.08, Offset='0,4'}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:SearchViewModel}}, Path=SelectProviderCommand}"
                                                     CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>

                            <Grid RowDefinitions="140,Auto" RowSpacing="0">

                                <!-- Provider Image Header -->
                                <Border Grid.Row="0"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 20,20,0,0"
                                        HeightRequest="140">
                                    <Grid>
                                        <!-- Gradient Background -->
                                        <BoxView>
                                            <BoxView.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#3B82F6" Offset="0.0" />
                                                    <GradientStop Color="#A855F7" Offset="0.5" />
                                                    <GradientStop Color="#EC4899" Offset="1.0" />
                                                </LinearGradientBrush>
                                            </BoxView.Background>
                                        </BoxView>

                                        <!-- Overlay -->
                                        <BoxView BackgroundColor="#00000033" />

                                        <!-- Business Initial/Logo -->
                                        <Label Text="{Binding BusinessName, StringFormat='{0:C}'}"
                                               FontSize="48"
                                               FontAttributes="Bold"
                                               TextColor="White"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center" />

                                        <!-- Available Now Badge -->
                                        <Border HorizontalOptions="End"
                                               VerticalOptions="Start"
                                               Margin="12"
                                               BackgroundColor="#FFFFFFE6"
                                               StrokeThickness="0"
                                               StrokeShape="RoundRectangle 12"
                                               Padding="10,4">
                                            <Label Text="🔥 Available Now"
                                                   FontSize="11"
                                                   FontAttributes="Bold"
                                                   TextColor="#1F2937" />
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- Provider Info -->
                                <VerticalStackLayout Grid.Row="1" Padding="16" Spacing="10">

                                    <!-- Name and Rating Row -->
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Grid.Column="0"
                                               Text="{Binding BusinessName}"
                                               FontSize="18"
                                               FontAttributes="Bold"
                                               TextColor="#1F2937"
                                               LineBreakMode="TailTruncation"
                                               VerticalOptions="Center" />

                                        <Border Grid.Column="1"
                                               BackgroundColor="#FEF3C7"
                                               StrokeThickness="0"
                                               StrokeShape="RoundRectangle 12"
                                               Padding="8,4">
                                            <Label FontSize="13" FontAttributes="Bold" TextColor="#D97706">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="⭐ " />
                                                        <Span Text="{Binding RatingAverage, StringFormat='{0:F1}'}" />
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>
                                        </Border>
                                    </Grid>

                                    <!-- Description -->
                                    <Label Text="{Binding Description}"
                                           FontSize="14"
                                           TextColor="#6B7280"
                                           LineBreakMode="TailTruncation"
                                           MaxLines="2" />

                                    <!-- Location -->
                                    <HorizontalStackLayout Spacing="4" IsVisible="{Binding Locations.Count}">
                                        <Label Text="📍"
                                               FontSize="12" />
                                        <Label FontSize="13"
                                               TextColor="#9CA3AF">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{Binding Locations[0].City}" />
                                                    <Span Text=", " />
                                                    <Span Text="{Binding Locations[0].StateProvince}" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                    </HorizontalStackLayout>

                                    <!-- Divider -->
                                    <BoxView HeightRequest="1" BackgroundColor="#E5E7EB" Margin="0,4" />

                                    <!-- Available Today Section -->
                                    <Label Text="Available Today:"
                                           FontSize="15"
                                           FontAttributes="Bold"
                                           TextColor="#1F2937" />

                                    <!-- Time Slots - Dynamic based on current time -->
                                    <ScrollView Orientation="Horizontal">
                                        <HorizontalStackLayout Spacing="8"
                                                             BindableLayout.ItemsSource="{Binding Source={RelativeSource AncestorType={x:Type vm:SearchViewModel}}, Path=AvailableTimeSlots}">
                                            <BindableLayout.ItemTemplate>
                                                <DataTemplate x:DataType="x:String">
                                                    <Border StrokeThickness="0"
                                                            StrokeShape="RoundRectangle 10"
                                                            Padding="16,8"
                                                            BackgroundColor="#D1FAE5">
                                                        <Border.GestureRecognizers>
                                                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:SearchViewModel}}, Path=QuickBookCommand}"
                                                                                 CommandParameter="{Binding Source={RelativeSource AncestorType={x:Type models:Provider}}}" />
                                                        </Border.GestureRecognizers>
                                                        <Label Text="{Binding .}"
                                                               FontSize="12"
                                                               FontAttributes="Bold"
                                                               TextColor="#059669" />
                                                    </Border>
                                                </DataTemplate>
                                            </BindableLayout.ItemTemplate>
                                        </HorizontalStackLayout>
                                    </ScrollView>

                                    <!-- Booking Indicator -->
                                    <Label Text="🎉 3 people booked in the last hour"
                                           FontSize="12"
                                           TextColor="#A855F7"
                                           FontAttributes="Bold"
                                           HorizontalTextAlignment="Center"
                                           Margin="0,4,0,0" />

                                </VerticalStackLayout>

                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <!-- Loading Overlay -->
        <Grid Grid.Row="1"
              IsVisible="{Binding IsBusy}"
              BackgroundColor="#F0FFFFFF">
            <VerticalStackLayout Spacing="12" HorizontalOptions="Center" VerticalOptions="Center">
                <ActivityIndicator IsRunning="{Binding IsBusy}"
                                  Color="#A855F7"
                                  WidthRequest="48"
                                  HeightRequest="48" />
                <Label Text="Finding available slots..."
                       FontSize="16"
                       TextColor="#1F2937"
                       FontAttributes="Bold" />
            </VerticalStackLayout>
        </Grid>

    </Grid>

</ContentPage>
