<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:EmptySlot.Mobile.ViewModels"
             x:Class="EmptySlot.Mobile.Pages.ProviderLoginPage"
             x:DataType="vm:ProviderLoginViewModel"
             Title="{Binding Title}"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="25" VerticalOptions="Center">

            <!-- Logo/Header -->
            <VerticalStackLayout Spacing="10" Margin="0,0,0,30">
                <Label Text="EmptySlot"
                       FontSize="36"
                       FontAttributes="Bold"
                       TextColor="{StaticResource Primary}"
                       HorizontalTextAlignment="Center" />
                <Label Text="Provider Portal"
                       FontSize="18"
                       TextColor="{StaticResource Gray600}"
                       HorizontalTextAlignment="Center" />
            </VerticalStackLayout>

            <!-- Login Form -->
            <Frame Padding="20" CornerRadius="15" HasShadow="True">
                <VerticalStackLayout Spacing="15">
                    <Label Text="Sign In"
                           FontSize="24"
                           FontAttributes="Bold"
                           Margin="0,0,0,10" />

                    <!-- Email -->
                    <VerticalStackLayout Spacing="5">
                        <Label Text="Email" FontSize="14" TextColor="{StaticResource Gray600}" />
                        <Entry Text="{Binding Email}"
                               Placeholder="your@email.com"
                               Keyboard="Email"
                               BackgroundColor="{StaticResource Gray100}"
                               FontSize="16" />
                    </VerticalStackLayout>

                    <!-- Password -->
                    <VerticalStackLayout Spacing="5">
                        <Label Text="Password" FontSize="14" TextColor="{StaticResource Gray600}" />
                        <Entry Text="{Binding Password}"
                               Placeholder="••••••••"
                               IsPassword="True"
                               BackgroundColor="{StaticResource Gray100}"
                               FontSize="16" />
                    </VerticalStackLayout>

                    <!-- Login Button -->
                    <Button Text="Sign In"
                            Command="{Binding LoginCommand}"
                            BackgroundColor="{StaticResource Primary}"
                            TextColor="White"
                            HeightRequest="50"
                            CornerRadius="10"
                            FontSize="18"
                            FontAttributes="Bold"
                            Margin="0,10,0,0" />

                    <ActivityIndicator IsRunning="{Binding IsBusy}"
                                      IsVisible="{Binding IsBusy}"
                                      Color="{StaticResource Primary}"
                                      HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Frame>

            <!-- Register Link -->
            <HorizontalStackLayout HorizontalOptions="Center" Spacing="5">
                <Label Text="Don't have an account?"
                       TextColor="{StaticResource Gray600}"
                       FontSize="14" />
                <Label Text="Register here"
                       TextColor="{StaticResource Primary}"
                       FontSize="14"
                       FontAttributes="Bold">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoToRegistrationCommand}" />
                    </Label.GestureRecognizers>
                </Label>
            </HorizontalStackLayout>

            <!-- Back to Customer App -->
            <Button Text="Back to Customer App"
                    Command="{Binding Source={x:Reference Page}, Path=BackToCustomerCommand}"
                    BackgroundColor="Transparent"
                    TextColor="{StaticResource Gray600}"
                    FontSize="14"
                    Margin="0,20,0,0"
                    Clicked="OnBackToCustomer" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
