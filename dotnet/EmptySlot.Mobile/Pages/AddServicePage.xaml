<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:EmptySlot.Mobile.ViewModels"
             xmlns:models="clr-namespace:EmptySlot.Shared.Models;assembly=EmptySlot.Shared"
             x:Class="EmptySlot.Mobile.Pages.AddServicePage"
             x:DataType="vm:AddServiceViewModel"
             Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <Label Text="Add New Service"
                   FontSize="24"
                   FontAttributes="Bold"
                   Margin="0,0,0,10" />

            <VerticalStackLayout Spacing="5">
                <Label Text="Service Name *" FontSize="14" TextColor="{StaticResource Gray600}" />
                <Entry Text="{Binding ServiceName}"
                       Placeholder="e.g., Haircut, Massage, etc."
                       BackgroundColor="{StaticResource Gray100}" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="5">
                <Label Text="Category *" FontSize="14" TextColor="{StaticResource Gray600}" />
                <Picker ItemsSource="{Binding Categories}"
                        ItemDisplayBinding="{Binding Name}"
                        SelectedItem="{Binding SelectedCategory}"
                        FontSize="16" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="5">
                <Label Text="Description" FontSize="14" TextColor="{StaticResource Gray600}" />
                <Editor Text="{Binding Description}"
                        Placeholder="Brief description of the service..."
                        HeightRequest="100"
                        BackgroundColor="{StaticResource Gray100}" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="5">
                <Label Text="Duration (minutes) *" FontSize="14" TextColor="{StaticResource Gray600}" />
                <Entry Text="{Binding DurationMinutes}"
                       Keyboard="Numeric"
                       Placeholder="30"
                       BackgroundColor="{StaticResource Gray100}" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="5">
                <Label Text="Price *" FontSize="14" TextColor="{StaticResource Gray600}" />
                <Entry Text="{Binding Price}"
                       Keyboard="Numeric"
                       Placeholder="0.00"
                       BackgroundColor="{StaticResource Gray100}" />
            </VerticalStackLayout>

            <Button Text="Save Service"
                    Command="{Binding SaveServiceCommand}"
                    BackgroundColor="{StaticResource Primary}"
                    TextColor="White"
                    HeightRequest="50"
                    CornerRadius="10"
                    FontSize="18"
                    FontAttributes="Bold"
                    Margin="0,20,0,0" />

            <ActivityIndicator IsRunning="{Binding IsBusy}"
                              IsVisible="{Binding IsBusy}"
                              Color="{StaticResource Primary}" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
