<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:EmptySlot.Mobile.ViewModels"
             x:Class="EmptySlot.Mobile.Pages.ProviderRegistrationPage"
             x:DataType="vm:ProviderRegistrationViewModel"
             Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <Label Text="Create Provider Account"
                   FontSize="28"
                   FontAttributes="Bold"
                   Margin="0,10,0,20" />

            <!-- Personal Information -->
            <Frame Padding="15" CornerRadius="12" HasShadow="True">
                <VerticalStackLayout Spacing="15">
                    <Label Text="Personal Information"
                           FontSize="18"
                           FontAttributes="Bold" />

                    <VerticalStackLayout Spacing="5">
                        <Label Text="Full Name *" FontSize="14" TextColor="{StaticResource Gray600}" />
                        <Entry Text="{Binding FullName}"
                               Placeholder="John Doe"
                               BackgroundColor="{StaticResource Gray100}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="5">
                        <Label Text="Email *" FontSize="14" TextColor="{StaticResource Gray600}" />
                        <Entry Text="{Binding Email}"
                               Placeholder="your@email.com"
                               Keyboard="Email"
                               BackgroundColor="{StaticResource Gray100}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="5">
                        <Label Text="Password *" FontSize="14" TextColor="{StaticResource Gray600}" />
                        <Entry Text="{Binding Password}"
                               Placeholder="At least 6 characters"
                               IsPassword="True"
                               BackgroundColor="{StaticResource Gray100}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="5">
                        <Label Text="Confirm Password *" FontSize="14" TextColor="{StaticResource Gray600}" />
                        <Entry Text="{Binding ConfirmPassword}"
                               Placeholder="Re-enter password"
                               IsPassword="True"
                               BackgroundColor="{StaticResource Gray100}" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Frame>

            <!-- Business Information -->
            <Frame Padding="15" CornerRadius="12" HasShadow="True">
                <VerticalStackLayout Spacing="15">
                    <Label Text="Business Information"
                           FontSize="18"
                           FontAttributes="Bold" />

                    <VerticalStackLayout Spacing="5">
                        <Label Text="Business Name *" FontSize="14" TextColor="{StaticResource Gray600}" />
                        <Entry Text="{Binding BusinessName}"
                               Placeholder="Your Business Name"
                               BackgroundColor="{StaticResource Gray100}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="5">
                        <Label Text="Description" FontSize="14" TextColor="{StaticResource Gray600}" />
                        <Editor Text="{Binding Description}"
                                Placeholder="Brief description of your business..."
                                HeightRequest="100"
                                BackgroundColor="{StaticResource Gray100}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="5">
                        <Label Text="Phone *" FontSize="14" TextColor="{StaticResource Gray600}" />
                        <Entry Text="{Binding Phone}"
                               Placeholder="+1 (403) 555-1234"
                               Keyboard="Telephone"
                               BackgroundColor="{StaticResource Gray100}" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Frame>

            <!-- Location (Optional) -->
            <Frame Padding="15" CornerRadius="12" HasShadow="True">
                <VerticalStackLayout Spacing="15">
                    <Label Text="Location (Optional)"
                           FontSize="18"
                           FontAttributes="Bold" />

                    <VerticalStackLayout Spacing="5">
                        <Label Text="Street Address" FontSize="14" TextColor="{StaticResource Gray600}" />
                        <Entry Text="{Binding AddressLine1}"
                               Placeholder="123 Main Street"
                               BackgroundColor="{StaticResource Gray100}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="5">
                        <Label Text="City" FontSize="14" TextColor="{StaticResource Gray600}" />
                        <Entry Text="{Binding City}"
                               Placeholder="Calgary"
                               BackgroundColor="{StaticResource Gray100}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="5">
                        <Label Text="Postal Code" FontSize="14" TextColor="{StaticResource Gray600}" />
                        <Entry Text="{Binding PostalCode}"
                               Placeholder="T2P 1H9"
                               BackgroundColor="{StaticResource Gray100}" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Frame>

            <!-- Register Button -->
            <Button Text="Create Account"
                    Command="{Binding RegisterCommand}"
                    BackgroundColor="{StaticResource Primary}"
                    TextColor="White"
                    HeightRequest="50"
                    CornerRadius="10"
                    FontSize="18"
                    FontAttributes="Bold"
                    Margin="0,10,0,0" />

            <ActivityIndicator IsRunning="{Binding IsBusy}"
                              IsVisible="{Binding IsBusy}"
                              Color="{StaticResource Primary}"
                              HorizontalOptions="Center" />

            <!-- Login Link -->
            <HorizontalStackLayout HorizontalOptions="Center" Spacing="5">
                <Label Text="Already have an account?"
                       TextColor="{StaticResource Gray600}"
                       FontSize="14" />
                <Label Text="Sign in here"
                       TextColor="{StaticResource Primary}"
                       FontSize="14"
                       FontAttributes="Bold">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoToLoginCommand}" />
                    </Label.GestureRecognizers>
                </Label>
            </HorizontalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
