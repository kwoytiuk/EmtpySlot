<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:EmptySlot.Mobile.ViewModels"
             xmlns:models="clr-namespace:EmptySlot.Shared.Models;assembly=EmptySlot.Shared"
             x:Class="EmptySlot.Mobile.Pages.StaffManagementPage"
             x:DataType="vm:StaffManagementViewModel"
             Title="{Binding Title}">

    <Grid RowDefinitions="*,Auto">

        <!-- Staff List -->
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="20" Spacing="15">

                <Label Text="Your Team"
                       FontSize="22"
                       FontAttributes="Bold"
                       Margin="0,0,0,10" />

                <CollectionView ItemsSource="{Binding StaffMembers}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:StaffMember">
                            <Frame Padding="15" Margin="0,5" CornerRadius="12" HasShadow="True">
                                <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto">

                                    <!-- Name -->
                                    <Label Text="{Binding Name}"
                                           FontSize="18"
                                           FontAttributes="Bold"
                                           Grid.Row="0"
                                           Grid.Column="0" />

                                    <!-- Email -->
                                    <Label Text="{Binding Email}"
                                           FontSize="14"
                                           TextColor="{StaticResource Gray600}"
                                           Grid.Row="1"
                                           Grid.Column="0" />

                                    <!-- Phone -->
                                    <Label Text="{Binding Phone}"
                                           FontSize="14"
                                           TextColor="{StaticResource Gray600}"
                                           Grid.Row="2"
                                           Grid.Column="0"
                                           IsVisible="{Binding Phone, Converter={StaticResource IsNotNullConverter}}" />

                                    <!-- Actions -->
                                    <VerticalStackLayout Grid.Row="0"
                                                        Grid.RowSpan="3"
                                                        Grid.Column="1"
                                                        Spacing="10"
                                                        VerticalOptions="Center">

                                        <!-- Manage Schedule Button -->
                                        <Button Text="📅 Schedule"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:StaffManagementViewModel}}, Path=ManageScheduleCommand}"
                                                CommandParameter="{Binding .}"
                                                BackgroundColor="{StaticResource Primary}"
                                                TextColor="White"
                                                FontSize="12"
                                                Padding="10,5"
                                                CornerRadius="8" />

                                        <!-- Delete Button -->
                                        <Button Text="🗑️"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:StaffManagementViewModel}}, Path=DeleteStaffCommand}"
                                                CommandParameter="{Binding .}"
                                                BackgroundColor="{StaticResource Gray200}"
                                                TextColor="#DA3743"
                                                FontSize="18"
                                                Padding="10,5"
                                                CornerRadius="8"
                                                WidthRequest="45" />

                                    </VerticalStackLayout>

                                </Grid>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                    <CollectionView.EmptyView>
                        <VerticalStackLayout Padding="40" Spacing="10" VerticalOptions="Center">
                            <Label Text="No staff members yet"
                                   FontSize="18"
                                   TextColor="{StaticResource Gray600}"
                                   HorizontalTextAlignment="Center" />
                            <Label Text="Add your first employee to get started"
                                   FontSize="14"
                                   TextColor="{StaticResource Gray600}"
                                   HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>
                </CollectionView>

                <ActivityIndicator IsRunning="{Binding IsBusy}"
                                  IsVisible="{Binding IsBusy}"
                                  Color="{StaticResource Primary}"
                                  Margin="0,20" />

            </VerticalStackLayout>
        </ScrollView>

        <!-- Add Button -->
        <Button Text="+ Add Staff Member"
                Command="{Binding AddStaffCommand}"
                BackgroundColor="{StaticResource Primary}"
                TextColor="White"
                HeightRequest="55"
                FontSize="18"
                FontAttributes="Bold"
                Margin="20,10"
                CornerRadius="10"
                Grid.Row="1" />

    </Grid>

</ContentPage>
