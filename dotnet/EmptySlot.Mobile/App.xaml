<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:EmptySlot.Mobile.Converters"
             x:Class="EmptySlot.Mobile.App">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Converters -->
            <converters:IsNotNullConverter x:Key="IsNotNullConverter" />
            <converters:InvertedBoolConverter x:Key="InvertedBoolConverter" />
            <converters:StringNotEmptyConverter x:Key="StringNotEmptyConverter" />

            <!-- Colors - Modern Professional Palette -->
            <Color x:Key="Primary">#2563EB</Color>
            <Color x:Key="PrimaryDark">#1D4ED8</Color>
            <Color x:Key="PrimaryLight">#3B82F6</Color>
            <Color x:Key="Accent">#34D399</Color>
            <Color x:Key="AccentDark">#10B981</Color>
            <Color x:Key="Secondary">#64748B</Color>
            <Color x:Key="Tertiary">#DFE7FD</Color>
            <Color x:Key="White">White</Color>
            <Color x:Key="Black">Black</Color>
            <Color x:Key="Gray50">#F9FAFB</Color>
            <Color x:Key="Gray100">#F3F4F6</Color>
            <Color x:Key="Gray200">#E5E7EB</Color>
            <Color x:Key="Gray300">#D1D5DB</Color>
            <Color x:Key="Gray400">#9CA3AF</Color>
            <Color x:Key="Gray500">#6B7280</Color>
            <Color x:Key="Gray600">#4B5563</Color>
            <Color x:Key="Gray700">#374151</Color>
            <Color x:Key="Gray800">#1F2937</Color>
            <Color x:Key="Gray900">#111827</Color>
            <Color x:Key="Success">#10B981</Color>
            <Color x:Key="Warning">#F59E0B</Color>
            <Color x:Key="Error">#EF4444</Color>
        </ResourceDictionary>
    </Application.Resources>
</Application>
