@page "/search"
@inject IApiService ApiService
@inject NavigationManager Navigation
@using System.Collections.ObjectModel

<div class="search-page">
    <!-- Clean Search Bar -->
    <div class="search-bar">
        <input type="text"
               class="search-input"
               placeholder="What are you looking for?"
               @bind="searchQuery"
               @bind:event="oninput" />
        <button class="search-btn" @onclick="SearchAsync">
            🔍
        </button>
    </div>

    <!-- Filter Controls -->
    <div class="filter-controls">
        <!-- Category Dropdown -->
        <select class="filter-select" @bind="selectedCategoryId" @bind:after="SearchAsync">
            <option value="">All Services</option>
            @if (categories != null)
            {
                @foreach (var category in categories)
                {
                    <option value="@category.Id">@category.Icon @category.Name</option>
                }
            }
        </select>

        <!-- Location Input -->
        <input type="text"
               class="filter-input"
               placeholder="📍 City"
               @bind="searchCity"
               @bind:event="oninput"
               @bind:after="SearchAsync" />

        <!-- Distance Dropdown -->
        <select class="filter-select" @bind="selectedRadius" @bind:after="SearchAsync">
            <option value="5 km">5 km</option>
            <option value="10 km">10 km</option>
            <option value="25 km">25 km</option>
            <option value="50 km">50 km</option>
            <option value="100 km">100 km</option>
        </select>

        <!-- Sort Dropdown -->
        <select class="filter-select" @bind="sortBy" @bind:after="SearchAsync">
            <option value="">Sort by</option>
            <option value="distance">Distance</option>
            <option value="rating-high">Rating (High)</option>
            <option value="rating-low">Rating (Low)</option>
            <option value="price-low">Price (Low)</option>
            <option value="price-high">Price (High)</option>
        </select>

        <!-- Verified Filter -->
        <label class="filter-checkbox">
            <input type="checkbox" @bind="verifiedOnly" @bind:after="SearchAsync" />
            <span>✓ Verified</span>
        </label>

        <!-- Map Button -->
        <button class="filter-button" @onclick="NavigateToMap">
            🗺️ Map
        </button>
    </div>

    <!-- Provider Grid (2 columns) -->
    <div class="provider-grid">
        @if (isBusy)
        {
            <div class="loading">Loading...</div>
        }
        else if (providers == null || !providers.Any())
        {
            <div class="empty-view">
                <div class="empty-icon">🔍</div>
                <div class="empty-title">No providers found</div>
                <div class="empty-subtitle">Try adjusting your filters</div>
            </div>
        }
        else
        {
            @foreach (var provider in providers)
            {
                <div class="provider-card" @onclick="() => SelectProvider(provider)">
                    <!-- Provider Image with Time Slot Buttons -->
                    <div class="provider-image">
                        <div class="gradient-bg"></div>
                        <div class="business-initial">@GetBusinessInitial(provider.BusinessName)</div>
                        <div class="slot-overlay">
                            @if (providerUpcomingSlots.TryGetValue(provider.Id, out var slots) && slots.Any())
                            {
                                <div class="slot-buttons">
                                    @foreach (var slot in slots)
                                    {
                                        <button class="slot-button" @onclick="() => BookSlot(provider, slot)" @onclick:stopPropagation="true">
                                            @slot.StartTime.ToString("h:mm tt")
                                        </button>
                                    }
                                </div>
                            }
                            else if (providerUpcomingSlots.ContainsKey(provider.Id))
                            {
                                <span class="no-slots">No slots in 2h</span>
                            }
                            else
                            {
                                <span class="loading-slots">Loading...</span>
                            }
                        </div>
                    </div>

                    <!-- Provider Info -->
                    <div class="provider-info">
                        <div class="provider-rating">
                            ⭐ @provider.RatingAverage.ToString("F1")
                        </div>
                        <div class="provider-name">@provider.BusinessName</div>
                        @if (provider.Locations.Any())
                        {
                            <div class="provider-location">@provider.Locations.First().City</div>
                        }
                    </div>
                </div>
            }
        }
    </div>
</div>

@code {
    private string? searchQuery;
    private string? searchCity = "Calgary";
    private string? selectedRadius = "50 km";
    private string? selectedCategoryId = "";
    private string? sortBy = "";
    private bool verifiedOnly = false;
    private bool featuredOnly = false;
    private bool isBusy = false;
    private double? currentLatitude;
    private double? currentLongitude;
    private List<Provider>? providers;
    private List<ServiceCategory>? categories;
    private Dictionary<Guid, List<TimeSlotDto>> providerUpcomingSlots = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadCategoriesAsync();
        await SearchAsync();
    }

    private async Task LoadCategoriesAsync()
    {
        try
        {
            categories = await ApiService.GetCategoriesAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Failed to load categories: {ex.Message}");
            categories = new List<ServiceCategory>();
        }
    }

    private async Task SearchAsync()
    {
        if (isBusy) return;

        try
        {
            isBusy = true;

            var radiusKm = double.TryParse(selectedRadius?.Split(' ')[0] ?? "50", out var radius) ? (double?)radius : null;
            Guid? categoryId = !string.IsNullOrEmpty(selectedCategoryId) && Guid.TryParse(selectedCategoryId, out var catId) ? catId : null;

            var request = new SearchProvidersRequest(
                Latitude: currentLatitude,
                Longitude: currentLongitude,
                RadiusKm: radiusKm,
                CategoryId: categoryId,
                Verified: verifiedOnly ? true : null
            );

            var results = await ApiService.SearchProvidersAsync(request);

            if (featuredOnly)
            {
                results = results.Where(p => p.IsFeatured).ToList();
            }

            // Apply sorting
            providers = sortBy switch
            {
                "rating-high" => results.OrderByDescending(p => p.RatingAverage).ToList(),
                "rating-low" => results.OrderBy(p => p.RatingAverage).ToList(),
                _ => results
            };

            if (providers.Any())
            {
                _ = LoadProviderUpcomingSlotsAsync();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Search failed: {ex.Message}");
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task LoadProviderUpcomingSlotsAsync()
    {
        try
        {
            var now = DateTime.Now;
            var twoHoursLater = now.AddHours(2);
            var today = now.Date;
            var tomorrow = today.AddDays(1);

            if (providers == null) return;

            var tasks = providers.Select(async provider =>
            {
                try
                {
                    // Get slots for today and tomorrow
                    var slots = await ApiService.GetAvailableTimeSlotsAsync(provider.Id, today, tomorrow);

                    // Filter to get slots within next 2 hours
                    var upcomingSlots = slots
                        .Where(s => {
                            var slotDateTime = s.Date.ToDateTime(s.StartTime);
                            return slotDateTime >= now && slotDateTime <= twoHoursLater;
                        })
                        .OrderBy(s => s.Date)
                        .ThenBy(s => s.StartTime)
                        .Take(3) // Show max 3 slots
                        .ToList();

                    providerUpcomingSlots[provider.Id] = upcomingSlots;
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"Error loading slots for {provider.BusinessName}: {ex.Message}");
                    providerUpcomingSlots[provider.Id] = new List<TimeSlotDto>();
                }
            });

            await Task.WhenAll(tasks);
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading upcoming slots: {ex.Message}");
        }
    }

    private void BookSlot(Provider provider, TimeSlotDto slot)
    {
        // Navigate to booking page with provider and slot info
        Console.WriteLine($"Booking slot: {slot.StartTime} with {provider.BusinessName}");
        // TODO: Navigate to booking page with parameters
        // Navigation.NavigateTo($"/booking?providerId={provider.Id}&slotId={slot.Id}");
    }

    private string GetBusinessInitial(string businessName)
    {
        return string.IsNullOrEmpty(businessName) ? "?" : businessName[0].ToString().ToUpper();
    }

    private void SelectProvider(Provider provider)
    {
        // TODO: Navigate to booking page
        Console.WriteLine($"Selected provider: {provider.BusinessName}");
    }

    private void NavigateToMap()
    {
        // Navigate to map page
        Navigation.NavigateTo("/map");
    }
}
