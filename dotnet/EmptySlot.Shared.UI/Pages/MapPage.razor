@page "/map"
@inject IApiService ApiService
@inject IJSRuntime JSRuntime

<div class="map-page">
    <div class="map-header">
        <h1 class="map-title">Provider Map</h1>
        <button class="location-btn" @onclick="CenterOnUserLocation">📍 My Location</button>
    </div>

    <div id="map" class="map-container"></div>

    @if (isLoading)
    {
        <div class="map-loading">
            <div class="spinner"></div>
            <p>Loading providers...</p>
        </div>
    }
</div>

@code {
    private List<Provider>? providers;
    private bool isLoading = true;
    private bool mapInitialized = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                // Initialize map centered on default location (San Francisco)
                await JSRuntime.InvokeVoidAsync("initializeMap", 37.7749, -122.4194, 12);
                mapInitialized = true;

                // Load providers
                await LoadProvidersAsync();
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error initializing map: {ex.Message}");
            }
        }
    }

    private async Task LoadProvidersAsync()
    {
        try
        {
            isLoading = true;
            StateHasChanged();

            // Get providers from API
            var searchResults = await ApiService.SearchProvidersAsync(
                searchQuery: "",
                latitude: 37.7749,
                longitude: -122.4194,
                radiusMiles: 25
            );

            providers = searchResults?.Providers ?? new List<Provider>();

            // Add markers for each provider
            if (mapInitialized && providers.Any())
            {
                foreach (var provider in providers)
                {
                    if (provider.Locations.Any())
                    {
                        var location = provider.Locations.First();
                        await JSRuntime.InvokeVoidAsync("addMarker",
                            location.Latitude,
                            location.Longitude,
                            provider.BusinessName,
                            $"⭐ {provider.RatingAverage:F1} | {location.Address}"
                        );
                    }
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading providers: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task CenterOnUserLocation()
    {
        try
        {
            // In a real app, would get user's actual location
            // For now, just re-center on default location
            await JSRuntime.InvokeVoidAsync("centerMap", 37.7749, -122.4194, 13);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error centering map: {ex.Message}");
        }
    }
}
